# Groq API key — required for the LLM (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# LangSmith — required for tracing, prompt/dataset versioning, and evaluation
# (https://smith.langchain.com/)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=swiftvisa
